<!doctype html>
<html lang="en">
  <head>
    {{> head}}
  </head>
  <body class="bg-subtle">
    <div class="lg:grid lg:grid-cols-[var(--sidebar-width)_1fr]">
      {{> sidebar}}
      <div class="flex min-h-dvh min-w-0 flex-col">
        {{> topbar}}
        <main class="grow p-4 sm:p-6 lg:p-8">
          {{> @partial-block}}
        </main>
        {{> footer}}
      </div>
    </div>
    <script type="module" src="/src/js/main.js"></script>
    {{#if script}}<script type="module" src="/src/js/{{script}}.js"></script>{{/if}}
  </body>
</html>
