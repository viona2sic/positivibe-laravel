<div class="input-group-icon">
  <input type="password" class="form-control form-control-bordered pe-11" id="{{id}}" name="{{id}}" placeholder="{{placeholder}}" autocomplete="{{autocomplete}}" aria-label="{{placeholder}}" required />
  <button type="button" class="form-control-icon-end flex cursor-pointer text-muted hover:text-default" data-password-toggle="#{{id}}" aria-label="Show password">
    {{> icons/visibility size=20 class="[[data-visible]_&]:hidden"}}
    {{> icons/visibility-off size=20 class="hidden [[data-visible]_&]:block"}}
  </button>
</div>
