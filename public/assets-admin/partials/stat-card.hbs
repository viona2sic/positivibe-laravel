<div class="card">
  <div class="card-body">
    <div class="flex items-start justify-between gap-2">
      <div>
        <p class="mb-1.5 text-2xl leading-tight font-bold text-default">{{value}}</p>
        <p class="mb-0 whitespace-nowrap text-muted">{{label}}</p>
      </div>
      {{> (concat 'icons/' icon) size=26 class=(concat 'shrink-0 text-' color)}}
    </div>
    <div class="mt-5 flex items-center gap-4">
      <div class="progress grow" role="progressbar" aria-label="{{label}}" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar bg-{{color}}" style="width: {{percent}}%"></div>
      </div>
      <span class="text-xs text-muted">{{percent}}%</span>
    </div>
  </div>
</div>
